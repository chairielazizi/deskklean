# DeskKlean is developed on Linux and packaged on Windows, so line endings are
# pinned rather than left to each machine's core.autocrlf setting.
* text=auto eol=lf

# Binary assets — never rewritten
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.exe binary
*.dll binary
*.node binary

# Windows-only scripts must keep CRLF or they break
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
