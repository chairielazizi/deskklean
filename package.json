{
  "name": "deskklean",
  "version": "1.0.0",
  "description": "Windows Desktop System Cleanup & Optimization Tool — CCleaner Pro Inspired",
  "main": "dist/main/main.js",
  "author": "DeskKlean Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "electron:dev": "npm run build:main && concurrently --kill-others-on-fail \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "tar": "^7.5.22",
    "esbuild": "^0.25.0"
  }
}
